<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <h1><%= title %></h1>
    <p>
        ID: <%= id %><br> 
        Name: <%= firstName %> <%= lastName %><br>
        Email: <%= email %><br>
        <% if (age) { %>
            Age: <%= age %><br>
        <%}%>
        <% if (bio) {%>
            Bio: <%= bio %>
        <%}%>
    </p>
    <a href="/">Back to home</a>
</body>
</html>