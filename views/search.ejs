<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <h1><%= title %></h1>
    <p>
        ID: <%= user.id %><br> 
        Name: <%= user.firstName %> <%= user.lastName %><br>
        Email: <%= user.email %><br>
        <% if (user.age) { %>
            Age: <%= user.age %><br>
        <%}%>
        <% if (user.bio) {%>
            Bio: <%= user.bio %>
        <%}%>
    </p>
</body>
</html>



    <ul>
