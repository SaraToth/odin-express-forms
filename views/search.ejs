<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <h1><%= title %></h1>
    <p>
        <!-- Only attempts to render if user is passed from controller -->
        <% if (typeof user !== "undefined") {%>
            ID: <%= user.id %><br>
            Name: <%= user.firstName %> <%= user.lastName %><br>
            Email: <%= user.email %><br> 
            <% if (user.age) { %>
                Age: <%= user.age %><br>
            <%}%>
            <% if (user.bio) {%>
                Bio: <%= user.bio %>
            <%}%>
        <%}%>

        <!-- Only attempts to render when message is passed from controller -->
        <% if (typeof message !== "undefined") {%>
            <%= message %>
        <%}%>
    </p>
    <a href="/">Back to home</a>
</body>
</html>